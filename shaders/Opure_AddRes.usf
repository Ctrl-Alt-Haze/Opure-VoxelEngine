// ============================================================================
//  Opure_AddRes.usf
//  Cross-bank residual accumulation:
//
//      dst = RdBank(srcA, a) + RdBank(srcB, b)
//
//  WHY A SEPARATE KERNEL
//  ---------------------
//  Opure_Add.usf reads BOTH operands through RdAct(dir, ...), so they must
//  already sit in the same bank. That is impossible for a transformer residual:
//  o_proj must read the attention output's bank and therefore writes the
//  opposite one, which is where the residual stream already lives. The add
//  would then read and write the same resource, which D3D12 forbids.
//
//  So both sources are named explicitly as bank indices, and the caller is
//  required to pick a DESTINATION bank distinct from both. The residual
//  rotates A -> C -> B across layers, which makes that always possible.
//
//      P[0] = source A word offset
//      P[1] = source B word offset
//      P[2] = destination word offset
//      P[3] = element count
//      P[4] = source A bank (0=A, 1=B, 2=C)
//      P[5] = source B bank (0=A, 1=B, 2=C)
//      P[6] = destination bank (0=A, 1=B, 2=C), distinct from P[4] and P[5]
// ============================================================================
#include "Opure_Common.hlsl"

[numthreads(256, 1, 1)]
void AddResMain(uint3 tid : SV_DispatchThreadID)
{
    const uint a   = P[0];
    const uint b   = P[1];
    const uint dst = P[2];
    const uint n   = P[3];
    const uint ba  = P[4];
    const uint bb  = P[5];
    const uint bo  = P[6];

    const uint i = tid.x;
    if (i >= n) return;

    WrBank(bo, dst + i, AsU(AsF(RdBank(ba, a + i)) + AsF(RdBank(bb, b + i))));
}