// ============================================================================
//  Opure_FlashAttention_Decode.usf
//  Fused single-token multi-head attention over the paged KV cache, with an
//  online (streaming) softmax so no [seq x dim] score matrix is ever
//  materialised -- the whole KV cache is consumed in registers.
//
//  One group per query head. Threads are laid out across the head dimension so
//  the QK dot product reduces with WaveActiveSum inside each 32-lane wave, and
//  the per-wave scalars (at most four) are combined through groupshared memory.
//
//  Grouped-query attention is handled by mapping query head h to KV head
//  h / (nHeads / nKVHeads), which is what Qwen/LLaMA GQA models expect.
//
//  Two entry points are compiled from this file, ATT_THREADS = headDim, so that
//  head_dim 64 and head_dim 128 models both get a fully occupied group.
//
//  P[0] = rotated-query word offset
//  P[1] = KV cache word offset for this layer
//  P[2] = destination word offset
//  P[3] = nKVHeads
//  P[4] = headDim
//  P[5] = maxSeq
//  P[6] = seqLen (number of cached tokens to attend over, including this one)
//  P[7] = nHeads
//  P[8] = activation source bank (0=A, 1=B, 2=C)
//  P[9] = destination bank (0=A, 1=B, 2=C); must differ from P[8]
// ============================================================================
#include "Opure_Common.hlsl"

#ifndef OPURE_ATT_THREADS
#define OPURE_ATT_THREADS 64
#endif

#define ATT_WAVES (OPURE_ATT_THREADS / OPURE_WAVE_SIZE)

// Sized for the widest entry point (128 threads = 4 waves); the 64-thread
// entry point only uses the first two slots.
groupshared float gs_part[4];

[numthreads(OPURE_ATT_THREADS, 1, 1)]
void AttentionMain(uint3 tid : SV_DispatchThreadID, uint lg : SV_GroupIndex,
                   uint3 grp : SV_GroupID)
{
    const uint qOff = P[0], kvOff = P[1], outOff = P[2];
    const uint nKV = P[3], hd = P[4], maxSeq = P[5], seqLen = P[6], nH = P[7];
    const uint bank  = P[8];
    const uint obank = P[9];

    // One group per query head: the HEAD is the group ID, while `lg` is the
    // lane that owns one channel of the head dimension.
    const uint h = grp.x;
    if (h >= nH) return;

    const uint lane = lg;
    const uint kvGroup = nH / nKV;                 // queries per KV head
    const uint kvHead  = h / kvGroup;
    const uint qBase   = h * hd;

    const uint kvLayerStride = maxSeq * nKV * hd;
    const uint kBase = kvOff + kvHead * maxSeq * hd;
    const uint vBase = kvOff + kvLayerStride + kvHead * maxSeq * hd;

    float runningMax = -3.402823466e+38f;
    float runningSum = 0.0f;
    float acc = 0.0f;                              // this thread's head-dim channel

    const float qv = AsF(RdBank(bank, qOff + qBase + lane));

    for (uint s = 0; s < seqLen; ++s)
    {
        const uint kIdx = kBase + (s * hd) + lane;

        // Partial QK^T contribution for this thread's channel, then a SIMD
        // cross-lane reduction across each wave.
        const float partial = AsF(O_KV[kIdx]) * qv;
        const float waveSum = WaveActiveSum(partial);

        if ((lane & (OPURE_WAVE_SIZE - 1)) == 0)
        {
            gs_part[lane >> 5] = waveSum;
        }
        GroupMemoryBarrierWithGroupSync();

        // Every lane redundantly recombines the <=4 wave scalars; this is one
        // shared-memory read per sequence step and avoids a second barrier.
        float score = 0.0f;
        [unroll]
        for (uint w = 0; w < 2; ++w) score += gs_part[w];

        // Online softmax rescale.
        const float newMax = max(runningMax, score);
        const float corr  = (runningMax <= -3.4e38f) ? 0.0f : exp(runningMax - newMax);
        const float p     = exp(score - newMax);

        runningSum = runningSum * corr + p;
        const float v = AsF(O_KV[vBase + (s * hd) + lane]);
        acc = acc * corr + p * v;

        runningMax = newMax;
        GroupMemoryBarrierWithGroupSync();   // protect gs_part for the next step
    }

    if (lane < hd)
    {
        WrBank(obank, outOff + qBase + lane, AsU(acc / max(runningSum, 1e-30f)));
    }
}

// Entry point compiled with OPURE_ATT_THREADS=128 for head_dim 128 models.
[numthreads(128, 1, 1)]
void AttentionMain128(uint3 tid : SV_DispatchThreadID, uint lg : SV_GroupIndex,
                      uint3 grp : SV_GroupID)
{
    const uint qOff = P[0], kvOff = P[1], outOff = P[2];
    const uint nKV = P[3], hd = P[4], maxSeq = P[5], seqLen = P[6], nH = P[7];
    const uint bank  = P[8];
    const uint obank = P[9];

    const uint h = grp.x;
    if (h >= nH) return;

    const uint lane = lg;
    const uint kvGroup = nH / nKV;
    const uint kvHead  = h / kvGroup;
    const uint qBase   = h * hd;

    const uint kvLayerStride = maxSeq * nKV * hd;
    const uint kBase = kvOff + kvHead * maxSeq * hd;
    const uint vBase = kvOff + kvLayerStride + kvHead * maxSeq * hd;

    float runningMax = -3.402823466e+38f;
    float runningSum = 0.0f;
    float acc = 0.0f;

    const float qv = AsF(RdBank(bank, qOff + qBase + lane));

    for (uint s = 0; s < seqLen; ++s)
    {
        const uint kIdx = kBase + (s * hd) + lane;
        const float partial = AsF(O_KV[kIdx]) * qv;
        const float waveSum = WaveActiveSum(partial);

        if ((lane & (OPURE_WAVE_SIZE - 1)) == 0) gs_part[lane >> 5] = waveSum;
        GroupMemoryBarrierWithGroupSync();

        float score = 0.0f;
        [unroll]
        for (uint w = 0; w < 4; ++w) score += gs_part[w];

        const float newMax = max(runningMax, score);
        const float corr  = (runningMax <= -3.4e38f) ? 0.0f : exp(runningMax - newMax);
        const float p     = exp(score - newMax);

        runningSum = runningSum * corr + p;
        const float v = AsF(O_KV[vBase + (s * hd) + lane]);
        acc = acc * corr + p * v;

        runningMax = newMax;
        GroupMemoryBarrierWithGroupSync();
    }

    if (lane < hd)
    {
        WrBank(obank, outOff + qBase + lane, AsU(acc / max(runningSum, 1e-30f)));
    }
}