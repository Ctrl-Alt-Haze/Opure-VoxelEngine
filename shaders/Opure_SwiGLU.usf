// ============================================================================
//  Opure_SwiGLU.usf
//  Gated MLP activation:  out = silu(gate) * up
//                    where  silu(g) = g * sigmoid(g)
//
//  This is the LLaMA/Qwen MLP nonlinearity. It reads two intermediate rows and
//  writes a third, which live in disjoint ranges of the activation buffer, so
//  there is no read/write aliasing on the UAV.
//
//  P[0] = gate word offset
//  P[1] = up   word offset
//  P[2] = destination word offset
//  P[3] = element count
//  P[4] = source bank (0=A, 1=B, 2=C)
//  P[5] = destination bank (0=A, 1=B, 2=C); must differ from P[4]
// ============================================================================
#include "Opure_Common.hlsl"

[numthreads(256, 1, 1)]
void SwiGLUMain(uint3 tid : SV_DispatchThreadID)
{
    const uint gate = P[0];
    const uint up   = P[1];
    const uint dst  = P[2];
    const uint n    = P[3];
    const uint bank = P[4];
    const uint obank= P[5];

    const uint i = tid.x;
    if (i >= n) return;

    const float g = AsF(RdBank(bank, gate + i));
    const float u = AsF(RdBank(bank, up + i));

    // Numerically stable sigmoid: avoid exp overflow for large negative g.
    const float s = (g >= 0.0f) ? (1.0f / (1.0f + exp(-g)))
                                : (exp(g) / (1.0f + exp(g)));
    const float silu = g * s;

    WrBank(obank, dst + i, AsU(silu * u));
}