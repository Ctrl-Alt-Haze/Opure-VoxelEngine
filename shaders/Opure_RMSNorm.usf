// ============================================================================
//  Opure_RMSNorm.usf
//  RMS normalisation followed by a learned scale, the standard LLaMA block
//  entry/exit norm.
//
//      y[i] = x[i] / sqrt( mean(x^2) + eps ) * w[i]
//
//  One 256-thread group normalises an entire hidden vector. Each thread
//  accumulates a strided partial sum of squares, WaveActiveSum collapses each
//  32-lane wave without a full group barrier, and only the 8 per-wave scalars go
//  through groupshared memory. That keeps the synchronisation cost to one
//  barrier per dispatch instead of one per element.
//
//  P[0] = source word offset
//  P[1] = norm weight word offset
//  P[2] = destination word offset
//  P[3] = d_model
//  P[4] = eps, as float bit pattern
//  P[5] = 1 if the norm weight is absent (identity scale)
//  P[6] = source bank (0=A, 1=B, 2=C)
//  P[7] = destination bank (0=A, 1=B, 2=C); must differ from P[6]
// ============================================================================
#include "Opure_Common.hlsl"

#define RM_THREADS 256
#define RM_WAVES   (RM_THREADS / OPURE_WAVE_SIZE)

groupshared float gs_waveSum[RM_WAVES];
groupshared float gs_total;

[numthreads(RM_THREADS, 1, 1)]
void RMSNormMain(uint3 tid : SV_DispatchThreadID, uint gid : SV_GroupIndex)
{
    const uint src = P[0];
    const uint wgt = P[1];
    const uint dst = P[2];
    const uint d   = P[3];
    const float eps = AsF(P[4]);
    const uint hasW = P[5];
    const uint bank  = P[6];
    const uint obank = P[7];

    // ---- pass 1: sum of squares ------------------------------------------
    float acc = 0.0f;
    for (uint i = gid; i < d; i += RM_THREADS)
    {
        const float v = AsF(RdBank(bank, src + i));
        acc += v * v;
    }

    // SIMD reduction across the 32 lanes of this wave: no shared-memory traffic
    // and no intra-wave barrier.
    const float waveSum = WaveActiveSum(acc);

    if ((gid & (OPURE_WAVE_SIZE - 1)) == 0)
    {
        gs_waveSum[gid >> 5] = waveSum;
    }
    GroupMemoryBarrierWithGroupSync();

    if (gid == 0)
    {
        // Written out rather than looped: this DXC build mis-compiles dynamic
        // indexing into a groupshared array inside an unrolled loop.
        gs_total = gs_waveSum[0] + gs_waveSum[1] + gs_waveSum[2] + gs_waveSum[3] +
                   gs_waveSum[4] + gs_waveSum[5] + gs_waveSum[6] + gs_waveSum[7];
    }
    GroupMemoryBarrierWithGroupSync();

    const float mean = gs_total / max(1.0f, (float)d);
    const float inv  = rsqrt(mean + eps);

    // ---- pass 2: normalise and scale -------------------------------------
    for (uint i = gid; i < d; i += RM_THREADS)
    {
        const float v = AsF(RdBank(bank, src + i));
        const float g = (hasW != 0) ? AsF(O_W[wgt + i]) : 1.0f;
        WrBank(obank, dst + i, AsU(v * inv * g));
    }
}