# Normalise line endings in the repository; check out platform-native.
#
# HLSL and GLSL are byte-oriented: a CRLF inside a .usf can change how DXC
# parses a line continuation. Text that must stay byte-exact regardless of
# platform is marked -text below.

* text=auto eol=lf

*.cpp  text eol=lf
*.h    text eol=lf
*.usf  text eol=lf
*.hlsl text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.cmake text eol=lf

# PowerShell is happiest with CRLF and the build scripts are Windows-only.
*.ps1  text eol=crlf

# Never touch line endings in these.
*.safetensors binary
*.gguf binary
*.png  binary
*.jpg  binary
*.ico  binary
